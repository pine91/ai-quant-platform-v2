# Local run uses SQLite when DATABASE_URL is unset. Compose supplies PostgreSQL.
DATABASE_URL=
REDIS_URL=
# Set a URL-safe password to override the Docker Compose local default.
POSTGRES_PASSWORD=
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCESS_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ENABLE_OVERNIGHT=false
ALPACA_API_KEY=
ALPACA_API_SECRET=
